# ==========================
# Base de donnees MySQL
# ==========================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=visioninspectia
DATABASE_USER=root
DATABASE_PASSWORD=password

# ==========================
# JWT
# ==========================
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# Serveur / CORS (production)
# ==========================
# PORT est fourni automatiquement par la plateforme cloud (Render/Railway) ;
# ne pas la definir manuellement en local, BACKEND_PORT (8000) est utilise a la place.
# PORT=

# URL(s) publique(s) du frontend deploye, separees par des virgules si plusieurs.
# En local, la valeur par defaut (http://localhost:5173) est deja geree par le code
# sans avoir besoin de definir cette variable.
# CORS_ORIGINS=https://mon-frontend.example.com

# DEBUG doit rester a False en production (desactive le reload et les erreurs detaillees).
# DEBUG=False

# Chemin absolu vers le fichier .keras du modele, uniquement si vous voulez
# le charger depuis un autre emplacement que celui embarque par defaut
# (backend/app/ml/model_files/best_model.keras).
# MODEL_PATH=
